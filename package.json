{
  "name": "gamevault",
  "version": "1.0.15",
  "description": "A Steam-powered game library and achievement showcase.",
  "author": "GameVault",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:config": "node scripts/write-app-config.js",
    "build": "npm run prepare:config && electron-builder",
    "build:release": "npm run prepare:config && electron-builder --publish never"
  },
  "build": {
    "appId": "com.gamevault.app",
    "productName": "GameVault",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "app.config.json",
      "build/GameVault.ico",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/GameVault.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "shortcutName": "GameVault",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18"
  }
}
